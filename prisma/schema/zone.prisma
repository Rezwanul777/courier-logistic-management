model Zone {
  id Int @id @default(autoincrement())

  code String @unique
  name String

  hubs Hub[]

  originRates RateCard[] @relation("OriginRateCards")

  destinationRates RateCard[] @relation("DestinationRateCards")

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}
