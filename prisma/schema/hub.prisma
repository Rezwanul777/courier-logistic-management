model Hub {
  id Int @id @default(autoincrement())

  code    String @unique
  name    String
  address String

  zoneId    Int
  zone      Zone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  deletedAt DateTime?

  originShipments Shipment[] @relation("OriginShipments")

  destinationShipments Shipment[] @relation("DestinationShipments")
  outgoingTransfers HubTransfer[] @relation("TransferFromHub")
  incomingTransfers HubTransfer[] @relation("TransferToHub")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([deletedAt])
}
