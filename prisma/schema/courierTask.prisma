model CourierTask {

  id Int @id @default(autoincrement())


  shipmentId Int

  shipment Shipment @relation("ShipmentTasks", fields:[shipmentId], references:[id], onDelete:Cascade)


  courierId Int

  courier User @relation( "CourierTasks",fields:[courierId],references:[id])


  assignedById Int

  assignedBy User @relation( "AssignedTasks", fields:[assignedById], references:[id] )


  type TaskType


  status TaskStatus @default(ASSIGNED)


  acceptedAt DateTime?


  completedAt DateTime?


  proof String?


  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt



  @@index([courierId,status])

  @@index([shipmentId])

}

